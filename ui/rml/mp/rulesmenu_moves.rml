<rml>
<head>
<title>rulesMenu_moves</title>
<link type="text/rcss" href="ui/rml/base.rcss"/>
<style>.item:hover span { color: #ffffffff; }</style>
</head>
<body style="background-color:#000000ff;" data-menu="rulesMenu_moves" data-x="0.0" data-y="0.0" data-onopen="setcvar ui_movesflag 0;setcvar ui_move_title 2;uiscript setMoveCharacter;uiscript setMovesListDefault">
<div class="screen">
<div style="position:absolute;left:0dp;top:0dp;width:640dp;height:480dp;">
<div class="item decoration" style="left:156dp;top:154dp;width:320dp;height:240dp;decorator:image(&quot;gfx/menus/main_centerblue&quot;);image-color:#ffffffff;" data-index="0" data-name="really_background" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text&quot;);image-color:#ffffffff;" data-index="1" data-name="background_text" data-group="none"></div>
<div class="item decoration" style="left:480dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text_right&quot;);image-color:#ffffffff;" data-index="2" data-name="background_text_b" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:640dp;height:480dp;decorator:image(&quot;gfx/menus/main_background&quot;);image-color:#ffffffff;" data-index="3" data-name="background" data-group="none"></div>
<div class="item hidden decoration" style="left:0dp;top:50dp;width:320dp;height:160dp;decorator:image(&quot;gfx/menus/menu_boxes_left&quot;);image-color:#ffffffff;" data-index="4" data-name="left_frame" data-group="lf_fr"></div>
<div class="item hidden decoration" style="left:0dp;top:0dp;width:0dp;height:0dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="5" data-name="button_glow" data-group="none"></div>
<div class="item decoration" style="left:100dp;top:5dp;width:440dp;height:24dp;decorator:image(&quot;gfx/menus/menu_blendbox&quot;);image-color:#8cdaffff;" data-index="6" data-name="game_rulesheader" data-group="rulesheader"><span style="top:-1dp;font-family:anewhope;font-size:17dp;left:-775dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_MOVES</span></div>
<div class="item decoration" style="left:25dp;top:47dp;width:255dp;height:23dp;background-color:#000099ff;" data-index="7" data-name="move_titles_box" data-group="none"></div>
<div class="item decoration" style="left:25dp;top:69dp;width:255dp;height:30dp;border:1dp #000099ff;" data-index="8" data-name="move_titles_outline" data-group="none"></div>
<div class="item decoration" style="left:25dp;top:47dp;width:255dp;height:23dp;" data-index="9" data-name="move_titles_title"><span style="top:0dp;font-family:anewhope;font-size:17dp;left:-875dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_MOVE_TYPES</span></div>
<div class="item" style="left:25dp;top:77dp;width:340dp;height:14dp;" data-index="10" data-name="move_titles" data-group="none" data-desc="@MENUS_CHOOSE_MOVE_DESC" data-action="uiscript resetMovesList;play sound/interface/button1.wav" data-mouseenter="show button_glow;setitemrect button_glow 0 73 320 24" data-mouseexit="hide button_glow"><span style="top:-5dp;font-family:ergoec;font-size:16dp;left:0dp;color:#9d9df4ff;"> <span class="cvartext" data-cvar="ui_move_title" data-multi="@MENUS_ACROBATICS;0;@MENUS_SINGLE_FAST;1;@MENUS_SINGLE_MEDIUM;2;@MENUS_SINGLE_STRONG;3;@MENUS_DUAL_SABERS;4;@MENUS_SABER_STAFF;5"></span></span></div>
<div class="item decoration" style="left:26dp;top:110dp;width:253dp;height:23dp;background-color:#000099ff;" data-index="11" data-name="moveslist_title_box" data-group="none"></div>
<div class="item decoration" style="left:35dp;top:108dp;width:253dp;height:26dp;" data-index="12" data-name="moveslist_title"><span style="top:0dp;font-family:anewhope;font-size:17dp;left:-875dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_MOVES</span></div>
<div class="item" style="left:26dp;top:131dp;width:253dp;height:250dp;" data-index="13" data-name="moveslist" data-group="none" data-desc="@MENUS_MOVE_DESC2" data-mouseenter="setitemcolor moveslist bordercolor 1 1 1 1" data-mouseexit="setitemcolor moveslist bordercolor 0 0 .8 1"></div>
<div class="item decoration" style="left:287dp;top:40dp;width:330dp;height:370dp;border:2dp #000099ff;" data-index="14" data-name="character_box" data-group="none"></div>
<div class="item decoration" style="left:295dp;top:-30dp;width:300dp;height:340dp;" data-index="15" data-name="character" data-group="models"></div>
<div class="item" style="left:295dp;top:300dp;width:320dp;height:90dp;" data-index="16" data-name="item_desc"></div>
<div class="item hidden" style="left:200dp;top:144dp;width:256dp;height:256dp;" data-index="17" data-name="creditsbutton" data-group="othermain" data-desc="@MENUS_SHOW_GAME_CREDITS" data-action="play sound/interface/button1.wav;close all;open creditsMenu"></div>
<div class="item" style="left:59dp;top:444dp;width:130dp;height:24dp;" data-index="18" data-name="backbutton" data-group="fade_buttons" data-desc="@MENUS_BACKTORULES" data-action="play sound/interface/esc.wav;close all;open rulesMenu" data-mouseenter="show button_glow;setitemrect button_glow 30 441 190 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#262626ff;">@MENUS_BACK</span><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_BACK</span></div>
<div class="item hidden decoration" style="left:255dp;top:444dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="19" data-name="exitgamebutton_glow" data-group="mods"></div>
<div class="item" style="left:255dp;top:444dp;width:130dp;height:24dp;" data-index="20" data-name="exitgamebutton" data-group="othermain" data-desc="@MENUS_LEAVE_JEDI_KNIGHT_II" data-action="play sound/weapons/saber/saberoff.mp3;close all;open quitMenu" data-mouseenter="show exitgamebutton_glow" data-mouseexit="hide exitgamebutton_glow"><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_EXIT</span></div>
</div>
<div id="rmlpaint" style="decorator:image(&quot;rmlpaint/rulesMenu_moves&quot;);"></div>
<div id="rmldesc" style="left:-680dp;top:424dp;font-size:14dp;text-align:center;color:#ffae00cc;width:2000dp;"></div>
</div>
</body>
</rml>
