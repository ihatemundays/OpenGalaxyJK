<div class="item" style="left:15dp;top:26dp;width:180dp;height:26dp;" data-index="9" data-name="getnewlist_button" data-group="none" data-desc="@MENUS_GET_UPDATED_SERVER_LIST" data-action="play sound/interface/button1.wav;uiscript RefreshServers" data-mouseenter="show button_glow2;setitemrect button_glow2 10 27 220 26" data-mouseexit="hide button_glow2"><span style="top:0dp;font-family:ergoec;font-size:20dp;left:0dp;color:#ffae00ff;">@MENUS_GET_NEW_LIST</span></div>
