<div class="item" style="left:59dp;top:444dp;width:130dp;height:24dp;" data-index="45" data-name="back" data-desc="@MENUS_BACKUP_ONE_MENU" data-action="play sound/interface/esc.wav;close joinserver;open multiplayermenu" data-mouseenter="show button_glow;setitemrect button_glow 30 441 190 30" data-mouseexit="hide button_glow"><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_BACK</span></div>
