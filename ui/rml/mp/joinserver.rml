<div class="item" style="left:455dp;top:444dp;width:200dp;height:32dp;" data-index="47" data-name="join_button" data-desc="@MENUS_JOIN_CHOSEN_SERVER" data-action="play sound/interface/button1.wav;uiscript checkpassword" data-mouseenter="show button_glow;setitemrect button_glow 425 441 190 30" data-mouseexit="hide button_glow"><span style="top:-1dp;font-family:anewhope;font-size:17dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_JOIN</span></div>
