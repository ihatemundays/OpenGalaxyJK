<div class="item" style="left:10dp;top:310dp;width:170dp;height:30dp;" data-index="4" data-name="refresh" data-desc="@MENUS_REFRESH_SERVER_LIST" data-action="play sound/interface/button1.wav;uiscript ServerStatus" data-mouseenter="show button_glow;setitemrect button_glow 0 310 200 28" data-mouseexit="hide button_glow"><span style="top:5dp;font-family:anewhope;font-size:13.6dp;left:-915dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_REFRESH_LIST</span></div>
