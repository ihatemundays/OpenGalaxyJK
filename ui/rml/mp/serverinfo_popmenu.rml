<body style="" data-menu="serverinfo_popmenu" data-x="141.0" data-y="61.0" data-onopen="uiscript ServerStatus">
<div class="screen">
<div style="position:absolute;left:141dp;top:61dp;width:360dp;height:360dp;">
<div class="item decoration" style="left:1dp;top:1dp;width:360dp;height:360dp;background-color:#000059e6;border:1dp #0000ccff;" data-index="0" data-name="setup_background" data-group="none"></div>
