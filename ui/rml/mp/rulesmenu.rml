<rml>
<head>
<title>rulesMenu</title>
<link type="text/rcss" href="ui/rml/base.rcss"/>
<style>.item:hover span { color: #ffffffff; }</style>
</head>
<body style="background-color:#000000ff;" data-menu="rulesMenu" data-x="0.0" data-y="0.0" data-onopen="setcvar ui_rules_backout 0">
<div class="screen">
<div style="position:absolute;left:0dp;top:0dp;width:640dp;height:480dp;">
<div class="item decoration" style="left:156dp;top:154dp;width:320dp;height:240dp;decorator:image(&quot;gfx/menus/main_centerblue&quot;);image-color:#ffffffff;" data-index="0" data-name="really_background" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text&quot;);image-color:#ffffffff;" data-index="1" data-name="background_text" data-group="none"></div>
<div class="item decoration" style="left:480dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text_right&quot;);image-color:#ffffffff;" data-index="2" data-name="background_text_b" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:640dp;height:480dp;decorator:image(&quot;gfx/menus/main_background&quot;);image-color:#ffffffff;" data-index="3" data-name="background" data-group="none"></div>
<div class="item decoration" style="left:107dp;top:8dp;width:428dp;height:112dp;decorator:image(&quot;gfx/menus/jediacademy&quot;);image-color:#ffffffff;" data-index="4" data-name="starwars" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:50dp;width:320dp;height:160dp;decorator:image(&quot;gfx/menus/menu_boxes_left&quot;);image-color:#ffffffff;" data-index="5" data-name="left_frame" data-group="lf_fr"></div>
<div class="item decoration" style="left:320dp;top:50dp;width:320dp;height:160dp;decorator:image(&quot;gfx/menus/menu_boxes_right&quot;);image-color:#ffffffff;" data-index="6" data-name="right_frame" data-group="rt_fr"></div>
<div class="item hidden decoration" style="left:0dp;top:0dp;width:0dp;height:0dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="7" data-name="button_glow" data-group="none"></div>
<div class="item" style="left:7dp;top:126dp;width:130dp;height:24dp;" data-index="8" data-name="playbutton" data-group="toprow" data-desc="@MENUS_START_PLAYING_NOW" data-action="play sound/interface/button1.wav;close all;open multiplayermenu" data-mouseenter="show button_glow;setitemrect button_glow 0 124 180 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_PLAY</span></div>
<div class="item" style="left:170dp;top:126dp;width:130dp;height:24dp;" data-index="9" data-name="profilebutton" data-group="toprow" data-desc="@MENUS_PROFILE_DESC" data-action="play sound/interface/button1.wav;close all;open playerMenu" data-mouseenter="show button_glow;setitemrect button_glow 120 124 230 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_PROFILE</span></div>
<div class="item" style="left:340dp;top:126dp;width:130dp;height:24dp;" data-index="10" data-name="controlsbutton" data-group="toprow" data-desc="@MENUS_CONFIGURE_GAME_CONTROLS" data-action="play sound/interface/button1.wav;close all;open controlsMenu" data-mouseenter="show button_glow;setitemrect button_glow 290 124 230 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_CONTROLS2</span></div>
<div class="item" style="left:502dp;top:126dp;width:130dp;height:24dp;" data-index="11" data-name="setupbutton" data-group="toprow" data-desc="@MENUS_CONFIGURE_GAME_SETTINGS" data-action="play sound/interface/button1.wav;close all;open setup_menu" data-mouseenter="show button_glow;setitemrect button_glow 452 124 230 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_SETUP</span></div>
<div class="item decoration" style="left:150dp;top:162dp;width:340dp;height:20dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="12" data-name="title_glow" data-group="none"></div>
<div class="item decoration" style="left:100dp;top:164dp;width:440dp;height:16dp;" data-index="13" data-name="default_rulesheader" data-group="rulesheader"><span style="top:-1dp;font-family:anewhope;font-size:11.9dp;left:-775dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_RULES</span></div>
<div class="item" style="left:225dp;top:190dp;width:190dp;height:40dp;" data-index="14" data-name="gamesmenubutton" data-group="default_submenu" data-desc="@MENUS_GAME_RULES" data-action="play sound/interface/button1.wav;close rulesMenu;open rulesMenu_games" data-mouseenter="show button_glow;setitemrect button_glow 175 196 300 30" data-mouseexit="hide button_glow"><span style="top:8dp;font-family:anewhope;font-size:17dp;left:-905dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_GAMES</span></div>
<div class="item" style="left:225dp;top:230dp;width:190dp;height:40dp;" data-index="15" data-name="forcemenubutton" data-group="default_submenu" data-desc="@MENUS_FORCE_RULES" data-action="play sound/interface/button1.wav;close rulesMenu;open rulesMenu_force" data-mouseenter="show button_glow;setitemrect button_glow 175 236 300 30" data-mouseexit="hide button_glow"><span style="top:8dp;font-family:anewhope;font-size:17dp;left:-905dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_FORCE_POWERS</span></div>
<div class="item" style="left:225dp;top:270dp;width:190dp;height:40dp;" data-index="16" data-name="weaponmenubutton" data-group="default_submenu" data-desc="@MENUS_WEAPON_RULES" data-action="play sound/interface/button1.wav;close rulesMenu;open rulesMenu_weapons" data-mouseenter="show button_glow;setitemrect button_glow 175 276 300 30" data-mouseexit="hide button_glow"><span style="top:8dp;font-family:anewhope;font-size:17dp;left:-905dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_WEAPONS</span></div>
<div class="item" style="left:225dp;top:310dp;width:190dp;height:40dp;" data-index="17" data-name="itemmenubutton" data-group="default_submenu" data-desc="@MENUS_ITEM_RULES" data-action="play sound/interface/button1.wav;close rulesMenu;open rulesMenu_items" data-mouseenter="show button_glow;setitemrect button_glow 175 316 300 30" data-mouseexit="hide button_glow"><span style="top:8dp;font-family:anewhope;font-size:17dp;left:-905dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_ITEMS</span></div>
<div class="item" style="left:225dp;top:350dp;width:190dp;height:40dp;" data-index="18" data-name="itemmenubutton" data-group="default_submenu" data-desc="@MENUS_MOVE_RULES" data-action="play sound/interface/button1.wav;close rulesMenu;open rulesMenu_moves" data-mouseenter="show button_glow;setitemrect button_glow 175 356 300 30" data-mouseexit="hide button_glow"><span style="top:8dp;font-family:anewhope;font-size:17dp;left:-905dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_MOVES</span></div>
<div class="item" style="left:59dp;top:444dp;width:130dp;height:24dp;" data-index="19" data-name="backbutton" data-group="fade_buttons" data-desc="@MENUS_BACKTOMAIN" data-action="play sound/interface/esc.wav;close all;open mainMenu" data-mouseenter="show button_glow;setitemrect button_glow 30 441 190 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#262626ff;">@MENUS_BACK</span><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_BACK</span></div>
<div class="item" style="left:255dp;top:444dp;width:130dp;height:24dp;" data-index="20" data-name="exitgamebutton" data-group="othermain" data-desc="@MENUS_LEAVE_JEDI_KNIGHT_II" data-action="play sound/weapons/saber/saberoff.mp3;close all;open quitMenu" data-mouseenter="show button_glow;setitemrect button_glow 225 441 190 30" data-mouseexit="hide button_glow"><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_EXIT</span></div>
</div>
<div id="rmlpaint" style="decorator:image(&quot;rmlpaint/rulesMenu&quot;);"></div>
<div id="rmldesc" style="left:-680dp;top:424dp;font-size:14dp;text-align:center;color:#ffae00cc;width:2000dp;"></div>
</div>
</body>
</rml>
