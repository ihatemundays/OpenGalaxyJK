<rml>
<head>
<title>quickgame</title>
<link type="text/rcss" href="ui/rml/base.rcss"/>
<style>.item:hover span { color: #ffffffff; }</style>
</head>
<body style="background-color:#000000ff;" data-menu="quickgame" data-x="0.0" data-y="0.0" data-onopen="uiscript loadArenas;uiscript checkforsiege;hide accept_alt;show accept;hide back_alt;show back;hide grpmessage">
<div class="screen">
<div style="position:absolute;left:0dp;top:0dp;width:640dp;height:480dp;">
<div class="item decoration" style="left:156dp;top:154dp;width:320dp;height:240dp;decorator:image(&quot;gfx/menus/main_centerblue&quot;);image-color:#ffffffff;" data-index="0" data-name="really_background" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text&quot;);image-color:#ffffffff;" data-index="1" data-name="background_text" data-group="none"></div>
<div class="item decoration" style="left:480dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text_right&quot;);image-color:#ffffffff;" data-index="2" data-name="background_text_b" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:640dp;height:480dp;decorator:image(&quot;gfx/menus/main_background&quot;);image-color:#ffffffff;" data-index="3" data-name="background" data-group="none"></div>
<div class="item decoration" style="left:150dp;top:11dp;width:340dp;height:30dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="4" data-name="title_glow" data-group="none"></div>
<div class="item decoration" style="left:50dp;top:14dp;width:540dp;height:16dp;" data-index="5" data-name="title" data-group="none"><span style="top:-1dp;font-family:anewhope;font-size:17dp;left:-730dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_SOLO_GAME</span></div>
<div class="item hidden decoration" style="left:0dp;top:0dp;width:0dp;height:0dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="6" data-name="button_glow" data-group="none"></div>
<div class="item" style="left:170dp;top:60dp;width:300dp;height:32dp;" data-index="7" data-name="solo_gametypefield" data-desc="@MENUS_ALLOWS_YOU_TO_SELECT" data-action="play sound/interface/button1.wav" data-mouseenter="show button_glow;setitemrect button_glow 125 57 400 38" data-mouseexit="hide button_glow"></div>
<div class="item decoration" style="left:30dp;top:105dp;width:200dp;height:24dp;" data-index="8" data-name="create_title" data-group="none"><span style="top:-1dp;font-family:anewhope;font-size:15.3dp;left:-900dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_MAP_LISTING</span></div>
<div class="item" style="left:36dp;top:126dp;width:194dp;height:250dp;" data-index="9" data-name="maplist" data-desc="@MENUS_CHOOSE_YOUR_GAME" data-action="play sound/interface/button1.wav" data-mouseenter="setitemcolor maplist bordercolor .79 .64 .22 1" data-mouseexit="setitemcolor maplist bordercolor .79 .64 .22 .5"></div>
<div class="item decoration" style="left:281dp;top:105dp;width:340dp;height:280dp;background-color:#00009980;border:1dp #000099ff;" data-index="10" data-name="setup_background" data-group="none"></div>
<div class="item" style="left:291dp;top:125dp;width:320dp;height:240dp;" data-index="11" data-name="mappreview"></div>
<div class="item decoration" style="left:290dp;top:124dp;width:322dp;height:242dp;border:1dp #44d2e240;" data-index="12" data-name="mappreview"></div>
<div class="item" style="left:59dp;top:444dp;width:130dp;height:24dp;" data-index="13" data-name="backbutton" data-group="fade_buttons" data-desc="@MENUS_BACKUP_ONE_MENU" data-action="play sound/interface/esc.wav;close all;open multiplayermenu" data-mouseenter="show button_glow;setitemrect button_glow 30 441 190 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#262626ff;">@MENUS_BACK</span><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_BACK</span></div>
<div class="item" style="left:255dp;top:444dp;width:130dp;height:24dp;" data-index="14" data-name="exitgamebutton" data-group="othermain" data-desc="@MENUS_LEAVE_JEDI_KNIGHT_II" data-action="play sound/weapons/saber/saberoff.mp3;close all;open quitMenu" data-mouseenter="show button_glow;setitemrect button_glow 225 441 190 30" data-mouseexit="hide button_glow"><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_EXIT</span></div>
<div class="item" style="left:455dp;top:444dp;width:200dp;height:32dp;" data-index="15" data-name="next_button" data-desc="@MENUS_CHOOSE_RULES" data-action="play sound/interface/button1.wav;close quickgame;open quickgame2" data-mouseenter="show button_glow;setitemrect button_glow 425 441 190 30" data-mouseexit="hide button_glow"><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_NEXT</span></div>
</div>
<div id="rmlpaint" style="decorator:image(&quot;rmlpaint/quickgame&quot;);"></div>
<div id="rmldesc" style="left:-680dp;top:424dp;font-size:14dp;text-align:center;color:#ffae00cc;width:2000dp;"></div>
</div>
</body>
</rml>
