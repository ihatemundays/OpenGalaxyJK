<rml>
<head>
<title>playerMenu</title>
<link type="text/rcss" href="ui/rml/base.rcss"/>
<style>.item:hover span { color: #ffffffff; }</style>
</head>
<body style="background-color:#000000ff;" data-menu="playerMenu" data-x="0.0" data-y="0.0" data-onopen="uiscript update ui_GetName">
<div class="screen">
<div style="position:absolute;left:0dp;top:0dp;width:640dp;height:480dp;">
<div class="item decoration" style="left:156dp;top:154dp;width:320dp;height:240dp;decorator:image(&quot;gfx/menus/main_centerblue&quot;);image-color:#ffffffff;" data-index="0" data-name="really_background" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text&quot;);image-color:#ffffffff;" data-index="1" data-name="background_text" data-group="none"></div>
<div class="item decoration" style="left:480dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text_right&quot;);image-color:#ffffffff;" data-index="2" data-name="background_text_b" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:640dp;height:480dp;decorator:image(&quot;gfx/menus/main_background&quot;);image-color:#ffffffff;" data-index="3" data-name="background" data-group="none"></div>
<div class="item decoration" style="left:107dp;top:8dp;width:428dp;height:112dp;decorator:image(&quot;gfx/menus/jediacademy&quot;);image-color:#ffffffff;" data-index="4" data-name="starwars" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:50dp;width:320dp;height:160dp;decorator:image(&quot;gfx/menus/menu_boxes_left&quot;);image-color:#ffffffff;" data-index="5" data-name="left_frame" data-group="lf_fr"></div>
<div class="item decoration" style="left:320dp;top:50dp;width:320dp;height:160dp;decorator:image(&quot;gfx/menus/menu_boxes_right&quot;);image-color:#ffffffff;" data-index="6" data-name="right_frame" data-group="rt_fr"></div>
<div class="item decoration" style="left:15dp;top:188dp;width:610dp;height:245dp;border:2dp #4c4eb0ff;" data-index="7" data-name="background" data-group="none"></div>
<div class="item decoration" style="left:15dp;top:186dp;width:610dp;height:20dp;background-color:#4c4eb0ff;" data-index="8" data-name="background" data-group="none"></div>
<div class="item hidden decoration" style="left:7dp;top:126dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="9" data-name="newgamebutton_glow" data-group="mods"></div>
<div class="item" style="left:7dp;top:126dp;width:130dp;height:24dp;" data-index="10" data-name="newgamebutton" data-group="toprow" data-desc="@MENUS_START_PLAYING_NOW" data-action="play sound/interface/button1.wav;close all;open multiplayermenu" data-mouseenter="show newgamebutton_glow" data-mouseexit="hide newgamebutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_PLAY</span></div>
<div class="item hidden decoration" style="left:170dp;top:126dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="11" data-name="profilebutton_glow" data-group="mods"></div>
<div class="item decoration" style="left:170dp;top:126dp;width:130dp;height:24dp;" data-index="12" data-name="profilebutton" data-group="toprow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffffffff;">@MENUS_PROFILE</span></div>
<div class="item hidden decoration" style="left:340dp;top:126dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="13" data-name="controlsbutton_glow" data-group="mods"></div>
<div class="item" style="left:340dp;top:126dp;width:130dp;height:24dp;" data-index="14" data-name="controlsbutton" data-group="toprow" data-desc="@MENUS_CONFIGURE_GAME_CONTROLS" data-action="play sound/interface/button1.wav;close all;open controlsmenu" data-mouseenter="show controlsbutton_glow" data-mouseexit="hide controlsbutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_CONTROLS2</span></div>
<div class="item hidden decoration" style="left:502dp;top:126dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="15" data-name="setupbutton_glow" data-group="mods"></div>
<div class="item" style="left:502dp;top:126dp;width:130dp;height:24dp;" data-index="16" data-name="setupbutton" data-group="toprow" data-desc="@MENUS_CONFIGURE_GAME_SETTINGS" data-action="play sound/interface/button1.wav;close all;open setup_menu" data-mouseenter="show setupbutton_glow" data-mouseexit="hide setupbutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_SETUP</span></div>
<div class="item hidden decoration" style="left:59dp;top:444dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="17" data-name="exitgamebutton_glow" data-group="mods"></div>
<div class="item" style="left:59dp;top:444dp;width:130dp;height:24dp;" data-index="18" data-name="exitgamebutton" data-group="exit" data-desc="@MENUS_JEDI_KNIGHT_II" data-action="play sound/weapons/saber/saberoff.mp3;close all;open quitMenu" data-mouseenter="show exitgamebutton_glow" data-mouseexit="hide exitgamebutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#262626ff;">@MENUS_EXIT</span><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_EXIT</span></div>
<div class="item hidden decoration" style="left:20dp;top:156dp;width:300dp;height:32dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="19" data-name="nameglow" data-group="mods"></div>
<div class="item" style="left:15dp;top:163dp;width:300dp;height:28dp;" data-index="20" data-name="namefield" data-desc="@MENUS_ENTER_YOUR_NAME_HERE" data-action="play sound/interface/button1.wav" data-mouseenter="show nameglow" data-mouseexit="hide nameglow"><span style="top:-5dp;font-family:ergoec;font-size:20dp;left:0dp;color:#9d9df4ff;">@MENUS_NAME1<span class="cvartext" data-cvar="ui_Name"></span></span></div>
<div class="item" style="left:320dp;top:184dp;width:0dp;height:0dp;" data-index="21" data-name="modeltitle" data-action="play sound/interface/button1.wav"><span style="top:-3dp;font-family:ergoec;font-size:20dp;left:-1000dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_CHARACTER_MODEL</span></div>
<div class="item" style="left:50dp;top:209dp;width:160dp;height:20dp;" data-index="22" data-name="setcolor" data-desc="@MENUS_CHOOSE_THE_COLOR_FOR" data-action="play sound/interface/button1.wav"></div>
<div class="item" style="left:31dp;top:225dp;width:404dp;height:194dp;" data-index="23" data-name="headlist" data-desc="@MENUS_CHOOSE_THE_MODEL_FOR" data-action="play sound/interface/button1.wav" data-mouseenter="setitemcolor headlist bordercolor 1 0 0 1" data-mouseexit="setitemcolor headlist bordercolor .5 .5 .5 1"></div>
<div class="item decoration" style="left:425dp;top:250dp;width:200dp;height:26dp;" data-index="24" data-name="customtitle"><span style="top:-3dp;font-family:ergoec;font-size:20dp;left:-900dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_CUSTOM</span></div>
<div class="item" style="left:480dp;top:280dp;width:96dp;height:96dp;decorator:image(&quot;gfx/mp/custom_mp_default&quot;);image-color:#808080ff;" data-index="25" data-name="custom" data-group="none" data-desc="@MENUS_CUSTOMPLAYER_DESC" data-action="play sound/interface/button1.wav;close playerMenu;open playerMenu2" data-mouseenter="setitemcolor custom forecolor 1 1 1 1" data-mouseexit="setitemcolor custom forecolor .5 .5 .5 1"></div>
<div class="item hidden decoration" style="left:455dp;top:444dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="26" data-name="next_glow" data-group="mods"></div>
<div class="item" style="left:455dp;top:444dp;width:130dp;height:24dp;" data-index="27" data-name="next" data-group="none" data-desc="@MENUS_APPLY_PLAYER_SABER" data-action="play sound/interface/button1.wav;close all;open saberMenu" data-mouseenter="show next_glow" data-mouseexit="hide next_glow"><span style="top:0dp;font-family:anewhope;font-size:17dp;left:-935dp;width:2000dp;text-align:center;color:#262626ff;">@MENUS_APPLY_CAPS</span><span style="top:-1dp;font-family:anewhope;font-size:17dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_APPLY_CAPS</span></div>
</div>
<div id="rmlpaint" style="decorator:image(&quot;rmlpaint/playerMenu&quot;);"></div>
<div id="rmldesc" style="left:-680dp;top:430dp;font-size:14dp;text-align:center;color:#ffae00cc;width:2000dp;"></div>
</div>
</body>
</rml>
