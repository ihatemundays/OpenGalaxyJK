<link type="text/rcss" href="ui/rml/base.rcss"/>
<style>.item:hover span { color: #ffffffff; }</style>
</head>
<body style="background-color:#000000ff;" data-menu="quickbots" data-x="100.0" data-y="50.0" data-onopen="">
<div class="screen">
