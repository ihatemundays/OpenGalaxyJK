<rml>
<head>
<title>playerMenu2</title>
<link type="text/rcss" href="ui/rml/base.rcss"/>
<style>.item:hover span { color: #ffffffff; }</style>
</head>
<body style="background-color:#000000ff;" data-menu="playerMenu2" data-x="0.0" data-y="0.0" data-onopen="uiscript getcharcvars;uiscript character">
<div class="screen">
<div style="position:absolute;left:0dp;top:0dp;width:640dp;height:480dp;">
<div class="item decoration" style="left:156dp;top:154dp;width:320dp;height:240dp;decorator:image(&quot;gfx/menus/main_centerblue&quot;);image-color:#ffffffff;" data-index="0" data-name="really_background" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text&quot;);image-color:#ffffffff;" data-index="1" data-name="background_text" data-group="none"></div>
<div class="item decoration" style="left:480dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text_right&quot;);image-color:#ffffffff;" data-index="2" data-name="background_text_b" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:640dp;height:480dp;decorator:image(&quot;gfx/menus/charmenu&quot;);image-color:#ffffffff;" data-index="3" data-name="background" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:-60dp;width:320dp;height:160dp;decorator:image(&quot;gfx/menus/menu_boxes_left&quot;);image-color:#ffffffff;" data-index="4" data-name="left_frame" data-group="lf_fr"></div>
<div class="item decoration" style="left:320dp;top:-60dp;width:320dp;height:160dp;decorator:image(&quot;gfx/menus/menu_boxes_right&quot;);image-color:#ffffffff;" data-index="5" data-name="right_frame" data-group="rt_fr"></div>
<div class="item decoration" style="left:100dp;top:54dp;width:440dp;height:16dp;decorator:image(&quot;gfx/menus/menu_blendbox&quot;);image-color:#8cdaffff;" data-index="6" data-name="creation_title" data-group="title"><span style="top:-1dp;font-family:anewhope;font-size:11.9dp;left:-775dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_CHARACTER_CREATION</span></div>
<div class="item decoration" style="left:52dp;top:84dp;width:900dp;height:1000dp;" data-index="7" data-name="character" data-group="models"></div>
<div class="item decoration" style="left:320dp;top:360dp;width:320dp;height:120dp;decorator:image(&quot;gfx/menus/charmenu_bottom&quot;);image-color:#ffffffff;" data-index="8" data-name="background2" data-group="none"></div>
<div class="item hidden decoration" style="left:7dp;top:16dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="9" data-name="newbutton_glow" data-group="none"></div>
<div class="item" style="left:7dp;top:16dp;width:130dp;height:24dp;" data-index="10" data-name="newgamebutton" data-group="nbut" data-desc="@MENUS_START_PLAYING_NOW" data-action="close all;open multiplayermenu" data-mouseenter="show newgamebutton_glow" data-mouseexit="hide newgamebutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_PLAY</span></div>
<div class="item decoration" style="left:170dp;top:16dp;width:130dp;height:24dp;" data-index="11" data-name="profilebutton" data-group="lbut"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffffffff;">@MENUS_PROFILE</span></div>
<div class="item hidden decoration" style="left:340dp;top:16dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="12" data-name="controlsbutton_glow" data-group="none"></div>
<div class="item" style="left:340dp;top:16dp;width:130dp;height:24dp;" data-index="13" data-name="controlsbutton" data-group="cbut" data-desc="@MENUS_CONFIGURE_GAME_CONTROLS" data-action="close all;open controlsMenu" data-mouseenter="show controlsbutton_glow" data-mouseexit="hide controlsbutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_CONTROLS2</span></div>
<div class="item hidden decoration" style="left:502dp;top:16dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="14" data-name="setupbutton_glow" data-group="none"></div>
<div class="item" style="left:502dp;top:16dp;width:130dp;height:24dp;" data-index="15" data-name="setupbutton" data-group="sbut" data-desc="@MENUS_CONFIGURE_GAME_SETTINGS" data-action="play sound/interface/button1.wav;close all;open setup_menu" data-mouseenter="show setupbutton_glow" data-mouseexit="hide setupbutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_SETUP</span></div>
<div class="item decoration" style="left:30dp;top:88dp;width:140dp;height:24dp;" data-index="16" data-name="species" data-group="none"><span style="top:-1dp;font-family:anewhope;font-size:17dp;left:0dp;color:#8cdaffff;">@MENUS_SPECIES</span></div>
<div class="item hidden decoration" style="left:176dp;top:92dp;width:150dp;height:16dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="17" data-name="speciesbut_glow" data-group="none"></div>
<div class="item" style="left:176dp;top:92dp;width:150dp;height:16dp;" data-index="18" data-name="speciesbut" data-group="none" data-desc="@MENUS_CHOOSE_SPECIES" data-action="play sound/interface/button1.wav;uiscript characterchanged;uiscript resetcharacterlistboxes" data-mouseenter="show speciesbut_glow" data-mouseexit="hide speciesbut_glow"><span style="top:-5dp;font-family:ergoec;font-size:18dp;left:0dp;color:#9d9df4ff;"> <span class="cvartext" data-cvar="ui_char_model" data-multilabel="@MENUS_MYLANGUAGE"></span></span></div>
<div class="item decoration" style="left:30dp;top:144dp;width:160dp;height:24dp;" data-index="19" data-name="color" data-group="none"><span style="top:-1dp;font-family:anewhope;font-size:17dp;left:0dp;color:#8cdaffff;">@MENUS_COLOR</span></div>
<div class="item" style="left:31dp;top:169dp;width:292dp;height:48dp;" data-index="20" data-name="colorbox" data-group="tints" data-action="play sound/interface/choose_color.wav"></div>
<div class="item decoration" style="left:30dp;top:252dp;width:180dp;height:24dp;" data-index="21" data-name="appear" data-group="none"><span style="top:-1dp;font-family:anewhope;font-size:17dp;left:0dp;color:#8cdaffff;">@MENUS_APPEARANCE</span></div>
<div class="item hidden decoration" style="left:30dp;top:280dp;width:90dp;height:16dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="22" data-name="headbut_glow" data-group="none"></div>
<div class="item" style="left:30dp;top:280dp;width:90dp;height:16dp;" data-index="23" data-name="headbut" data-group="none" data-desc="@MENUS_SELECT_HEAD" data-action="play sound/interface/button1.wav;show heads;hide torso;hide lower;transition2 character 52 84 900 1000 20 25" data-mouseenter="show headbut_glow" data-mouseexit="hide headbut_glow"><span style="top:-5dp;font-family:ergoec;font-size:18dp;left:0dp;color:#ffae00ff;">@MENUS_HEAD</span></div>
<div class="item hidden decoration" style="left:126dp;top:280dp;width:90dp;height:16dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="24" data-name="torsobut_glow" data-group="none"></div>
<div class="item" style="left:126dp;top:280dp;width:90dp;height:16dp;" data-index="25" data-name="torsobut" data-group="none" data-desc="@MENUS_SELECT_TORSO" data-action="play sound/interface/button1.wav;show torso;hide heads;hide lower;transition2 character 355 84 300 340 20 25" data-mouseenter="show torsobut_glow" data-mouseexit="hide torsobut_glow"><span style="top:-5dp;font-family:ergoec;font-size:18dp;left:0dp;color:#ffae00ff;">@MENUS_TORSO</span></div>
<div class="item hidden decoration" style="left:224dp;top:280dp;width:90dp;height:16dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="26" data-name="legsbut_glow" data-group="none"></div>
<div class="item" style="left:224dp;top:280dp;width:90dp;height:16dp;" data-index="27" data-name="legsbut" data-group="none" data-desc="@MENUS_SELECT_LEGS" data-action="play sound/interface/button1.wav;show lower;hide heads;hide torso;transition2 character 355 84 300 340 20 25" data-mouseenter="show legsbut_glow" data-mouseexit="hide legsbut_glow"><span style="top:-5dp;font-family:ergoec;font-size:18dp;left:0dp;color:#ffae00ff;">@MENUS_LEGS</span></div>
<div class="item" style="left:31dp;top:307dp;width:292dp;height:93dp;" data-index="28" data-name="headlistbox" data-group="heads" data-action="play sound/interface/choose_head.wav;uiscript char_skin"></div>
<div class="item hidden" style="left:31dp;top:307dp;width:292dp;height:93dp;" data-index="29" data-name="torsolistbox" data-group="torso" data-action="play sound/interface/choose_torso.wav;uiscript char_skin"></div>
<div class="item hidden" style="left:31dp;top:307dp;width:292dp;height:93dp;" data-index="30" data-name="lowerlistbox" data-group="lower" data-action="play sound/interface/choose_head.wav;uiscript char_skin"></div>
<div class="item hidden decoration" style="left:59dp;top:444dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="31" data-name="exitgamebutton_glow" data-group="mods"></div>
<div class="item" style="left:59dp;top:444dp;width:130dp;height:24dp;" data-index="32" data-name="exitgamebutton" data-group="exit" data-desc="@MENUS_BACK_2_PROFILE" data-action="play sound/weapons/saber/saberoff.mp3;close playerMenu2;open playerMenu" data-mouseenter="show exitgamebutton_glow" data-mouseexit="hide exitgamebutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#262626ff;">@MENUS_BACK</span><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_BACK</span></div>
<div class="item hidden decoration" style="left:455dp;top:444dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="33" data-name="next_glow" data-group="mods"></div>
<div class="item" style="left:455dp;top:444dp;width:130dp;height:24dp;" data-index="34" data-name="next" data-group="none" data-desc="@MENUS_APPLY_PLAYER_SABER" data-action="play sound/interface/button1.wav;close all;uiscript updatecharmodel;open saberMenu" data-mouseenter="show next_glow" data-mouseexit="hide next_glow"><span style="top:0dp;font-family:anewhope;font-size:17dp;left:-935dp;width:2000dp;text-align:center;color:#262626ff;">@MENUS_APPLY_CAPS</span><span style="top:-1dp;font-family:anewhope;font-size:17dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_APPLY_CAPS</span></div>
</div>
<div id="rmlpaint" style="decorator:image(&quot;rmlpaint/playerMenu2&quot;);"></div>
<div id="rmldesc" style="left:-680dp;top:430dp;font-size:14dp;text-align:center;color:#ffae00cc;width:2000dp;"></div>
</div>
</body>
</rml>
