<rml>
<head>
<title>quickgame2</title>
<link type="text/rcss" href="ui/rml/base.rcss"/>
<style>.item:hover span { color: #ffffffff; }</style>
</head>
<body style="background-color:#000000ff;" data-menu="quickgame2" data-x="0.0" data-y="0.0" data-onopen="hide accept_alt;show accept;hide back_alt;show back;hide grpmessage">
<div class="screen">
<div style="position:absolute;left:0dp;top:0dp;width:640dp;height:480dp;">
<div class="item decoration" style="left:156dp;top:154dp;width:320dp;height:240dp;decorator:image(&quot;gfx/menus/main_centerblue&quot;);image-color:#ffffffff;" data-index="0" data-name="really_background" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text&quot;);image-color:#ffffffff;" data-index="1" data-name="background_text" data-group="none"></div>
<div class="item decoration" style="left:480dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text_right&quot;);image-color:#ffffffff;" data-index="2" data-name="background_text_b" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:640dp;height:480dp;decorator:image(&quot;gfx/menus/main_background&quot;);image-color:#ffffffff;" data-index="3" data-name="background" data-group="none"></div>
<div class="item hidden decoration" style="left:0dp;top:0dp;width:0dp;height:0dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="4" data-name="button_glow" data-group="none"></div>
<div class="item decoration" style="left:150dp;top:11dp;width:340dp;height:30dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="5" data-name="title_glow" data-group="none"></div>
<div class="item decoration" style="left:50dp;top:14dp;width:540dp;height:16dp;" data-index="6" data-name="title" data-group="none"><span style="top:-1dp;font-family:anewhope;font-size:17dp;left:-730dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_SOLO_GAME</span></div>
<div class="item decoration" style="left:5dp;top:110dp;width:240dp;height:20dp;" data-index="7" data-name="rules_title" data-group="none"><span style="top:-2dp;font-family:anewhope;font-size:13.6dp;left:-880dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_GENERAL_RULES</span></div>
<div class="item cvarstate" style="left:5dp;top:130dp;width:240dp;height:20dp;" data-index="8" data-cvartest="ui_netGameType" data-cvarrule="hide" data-cvarvalues="1;2" data-name="options" data-group="grpOptions" data-desc="@MENUS_SABER_ONLY_INFO" data-action="play sound/interface/button1.wav" data-mouseenter="show button_glow;setitemrect button_glow 0 127 260 30" data-mouseexit="hide button_glow"><span style="top:-2dp;font-family:ergoec;font-size:18dp;left:-1835dp;width:2000dp;text-align:right;color:#9d9df4ff;">@MENUS_LIGHTSABER_ONLY</span><span class="cvartext" data-cvar="g_weaponDisable" data-yesno="on" style="top:-2dp;font-family:ergoec;font-size:18dp;left:173dp;color:#9d9df4ff;"></span></div>
<div class="item cvarstate" style="left:5dp;top:130dp;width:240dp;height:20dp;" data-index="9" data-cvartest="ui_netGameType" data-cvarrule="show" data-cvarvalues="1;2" data-name="options" data-group="grpOptions" data-desc="@MENUS_SABER_ONLY_INFO" data-action="play sound/interface/button1.wav" data-mouseenter="show button_glow;setitemrect button_glow 0 127 260 30" data-mouseexit="hide button_glow"><span style="top:-2dp;font-family:ergoec;font-size:18dp;left:-1835dp;width:2000dp;text-align:right;color:#9d9df4ff;">@MENUS_LIGHTSABER_ONLY</span><span class="cvartext" data-cvar="g_duelWeaponDisable" data-yesno="on" style="top:-2dp;font-family:ergoec;font-size:18dp;left:173dp;color:#9d9df4ff;"></span></div>
<div class="item cvarstate" style="left:5dp;top:150dp;width:240dp;height:20dp;" data-index="10" data-cvartest="ui_netGameType" data-cvarrule="hide" data-cvarvalues="4" data-name="options" data-group="grpOptions" data-desc="@MENUS_DISABLE_FORCE_INFO" data-action="uiscript forcePowersDisable;play sound/interface/button1.wav" data-mouseenter="show button_glow;setitemrect button_glow 0 147 260 30" data-mouseexit="hide button_glow"><span style="top:-2dp;font-family:ergoec;font-size:18dp;left:-1835dp;width:2000dp;text-align:right;color:#9d9df4ff;">@MENUS_DISABLE_FORCE</span><span class="cvartext" data-cvar="g_forcePowerDisable" data-yesno="on" style="top:-2dp;font-family:ergoec;font-size:18dp;left:173dp;color:#9d9df4ff;"></span></div>
<div class="item cvarstate" style="left:5dp;top:170dp;width:240dp;height:20dp;" data-index="11" data-cvartest="ui_netGameType" data-cvarrule="hide" data-cvarvalues="4" data-name="normal" data-group="grpsettings" data-desc="@MENUS_FORCE_MASTERY_INFO" data-action="play sound/interface/button1.wav" data-mouseenter="show button_glow;setitemrect button_glow 0 167 260 30" data-mouseexit="hide button_glow"></div>
<div class="item decoration" style="left:5dp;top:200dp;width:240dp;height:20dp;" data-index="12" data-name="end_game_title" data-group="none"><span style="top:-2dp;font-family:anewhope;font-size:13.6dp;left:-880dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_ENDGAME_RULES</span></div>
<div class="item" style="left:5dp;top:220dp;width:240dp;height:20dp;" data-index="13" data-name="normal" data-group="grpsettings" data-desc="@MENUS_THIS_VALUE_ADJUSTS_THE" data-action="play sound/interface/button1.wav" data-mouseenter="show button_glow;setitemrect button_glow 0 217 260 30" data-mouseexit="hide button_glow"><span style="top:-2dp;font-family:ergoec;font-size:18dp;left:-1835dp;width:2000dp;text-align:right;color:#9d9df4ff;">@MENUS_TIME_LIMIT</span><span class="cvartext" data-cvar="timelimit" style="top:-2dp;font-family:ergoec;font-size:18dp;left:173dp;color:#9d9df4ff;"></span></div>
<div class="item cvarstate" style="left:5dp;top:240dp;width:240dp;height:20dp;" data-index="14" data-cvartest="ui_netGameType" data-cvarrule="show" data-cvarvalues="0;3" data-name="normal" data-group="grpsettings" data-desc="@MENUS_ESTABLISH_THE_NUMBER" data-action="play sound/interface/button1.wav" data-mouseenter="show button_glow;setitemrect button_glow 0 237 260 30" data-mouseexit="hide button_glow"><span style="top:-2dp;font-family:ergoec;font-size:18dp;left:-1835dp;width:2000dp;text-align:right;color:#9d9df4ff;">@MENUS_KILL_LIMIT</span><span class="cvartext" data-cvar="fraglimit" style="top:-2dp;font-family:ergoec;font-size:18dp;left:173dp;color:#9d9df4ff;"></span></div>
<div class="item cvarstate" style="left:5dp;top:240dp;width:240dp;height:20dp;" data-index="15" data-cvartest="ui_netGameType" data-cvarrule="show" data-cvarvalues="5" data-name="normal" data-group="grpsettings" data-desc="@MENUS_THIS_IS_THE_NUMBER_OF" data-action="play sound/interface/button1.wav" data-mouseenter="show button_glow;setitemrect button_glow 0 237 260 30" data-mouseexit="hide button_glow"><span style="top:-2dp;font-family:ergoec;font-size:18dp;left:-1835dp;width:2000dp;text-align:right;color:#9d9df4ff;">@MENUS_CAPTURE_LIMIT</span><span class="cvartext" data-cvar="capturelimit" style="top:-2dp;font-family:ergoec;font-size:18dp;left:173dp;color:#9d9df4ff;"></span></div>
<div class="item cvarstate" style="left:5dp;top:240dp;width:240dp;height:20dp;" data-index="16" data-cvartest="ui_netGameType" data-cvarrule="hide" data-cvarvalues="0;3;4;5" data-name="normal" data-group="grpsettings" data-desc="@MENUS_VALUE_ADJUSTS_THE_TOTAL" data-action="play sound/interface/button1.wav" data-mouseenter="show button_glow;setitemrect button_glow 0 237 260 30" data-mouseexit="hide button_glow"><span style="top:-2dp;font-family:ergoec;font-size:18dp;left:-1835dp;width:2000dp;text-align:right;color:#9d9df4ff;">@MENUS_DUEL_LIMIT</span><span class="cvartext" data-cvar="duel_fraglimit" style="top:-2dp;font-family:ergoec;font-size:18dp;left:173dp;color:#9d9df4ff;"></span></div>
<div class="item decoration" style="left:5dp;top:280dp;width:240dp;height:20dp;" data-index="17" data-name="bots_title" data-group="none"><span style="top:-2dp;font-family:anewhope;font-size:13.6dp;left:-880dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_BOTS</span></div>
<div class="item" style="left:5dp;top:300dp;width:240dp;height:20dp;" data-index="18" data-name="expert_button" data-group="grpsettings" data-desc="@MENUS_PLAYERS_INFO" data-action="play sound/interface/button1.wav" data-mouseenter="show button_glow;setitemrect button_glow 0 297 260 30" data-mouseexit="hide button_glow"><span style="top:-2dp;font-family:ergoec;font-size:18dp;left:-1835dp;width:2000dp;text-align:right;color:#9d9df4ff;">@MENUS_PLAYERS</span><span class="cvartext" data-cvar="bot_minplayers" style="top:-2dp;font-family:ergoec;font-size:18dp;left:173dp;color:#9d9df4ff;"></span></div>
<div class="item" style="left:5dp;top:320dp;width:240dp;height:20dp;" data-index="19" data-name="expert_button" data-group="grpsettings" data-desc="@MENUS_SETS_THE_MAXIMUM_NUMBER" data-action="play sound/interface/button1.wav" data-mouseenter="show settingsButton1" data-mouseexit="hide settingsButton1;uiscript clampmaxplayers"><span style="top:-2dp;font-family:ergoec;font-size:18dp;left:-1835dp;width:2000dp;text-align:right;color:#9d9df4ff;">@MENUS_MAXIMUM_PLAYERS</span><span class="cvartext" data-cvar="sv_maxclients" style="top:-2dp;font-family:ergoec;font-size:18dp;left:173dp;color:#9d9df4ff;"></span></div>
<div class="item" style="left:5dp;top:340dp;width:240dp;height:20dp;" data-index="20" data-name="difficulty_button" data-desc="@MENUS_ADJUSTS_THE_DIFFICULTY" data-action="play sound/interface/button1.wav" data-mouseenter="show button_glow;setitemrect button_glow 0 337 260 30" data-mouseexit="hide button_glow"></div>
<div class="item" style="left:5dp;top:360dp;width:240dp;height:20dp;" data-index="21" data-name="custombots_button" data-desc="@MENUS_SELECT_BOTS_DESC" data-action="play sound/interface/button1.wav;open quickbots" data-mouseenter="show button_glow;setitemrect button_glow 0 357 260 30" data-mouseexit="hide button_glow"><span style="top:-2dp;font-family:ergoec;font-size:18dp;left:-880dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_SELECT_BOTS</span></div>
<div class="item decoration" style="left:281dp;top:105dp;width:340dp;height:280dp;background-color:#00009980;border:1dp #000099ff;" data-index="22" data-name="setup_background" data-group="none"></div>
<div class="item" style="left:291dp;top:125dp;width:320dp;height:240dp;" data-index="23" data-name="mappreview"></div>
<div class="item decoration" style="left:290dp;top:124dp;width:322dp;height:242dp;border:1dp #44d2e240;" data-index="24" data-name="mappreview"></div>
<div class="item" style="left:59dp;top:444dp;width:130dp;height:24dp;" data-index="25" data-name="back_button" data-group="fade_buttons" data-desc="@MENUS_BACKUP_ONE_MENU" data-action="play sound/interface/esc.wav;close quickgame2;open quickgame" data-mouseenter="show button_glow;setitemrect button_glow 30 441 190 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#262626ff;">@MENUS_BACK</span><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_BACK</span></div>
<div class="item" style="left:255dp;top:444dp;width:130dp;height:24dp;" data-index="26" data-name="exitgame_button" data-group="othermain" data-desc="@MENUS_LEAVE_JEDI_KNIGHT_II" data-action="play sound/weapons/saber/saberoff.mp3;close all;open quitMenu" data-mouseenter="show button_glow;setitemrect button_glow 225 441 190 30" data-mouseexit="hide button_glow"><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_EXIT</span></div>
<div class="item" style="left:455dp;top:444dp;width:200dp;height:32dp;" data-index="27" data-name="next_button" data-desc="@MENUS_START_SERVER" data-action="play sound/interface/button1.wav;uiscript weaponDisable;setcvar ui_singlePlayerActive 1;uiscript StartServer;close quickgame2" data-mouseenter="show button_glow;setitemrect button_glow 425 441 190 30" data-mouseexit="hide button_glow"><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_NEXT</span></div>
</div>
<div id="rmlpaint" style="decorator:image(&quot;rmlpaint/quickgame2&quot;);"></div>
<div id="rmldesc" style="left:-680dp;top:424dp;font-size:14dp;text-align:center;color:#ffae00cc;width:2000dp;"></div>
</div>
</body>
</rml>
