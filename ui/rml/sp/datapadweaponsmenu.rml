<rml>
<head>
<title>datapadWeaponsMenu</title>
<link type="text/rcss" href="ui/rml/base.rcss"/>
<style>.item:hover span { color: #ffffffff; }</style>
</head>
<body style="background-color:#000000ff;" data-menu="datapadWeaponsMenu" data-x="0.0" data-y="0.0" data-onopen="uiscript nextDataPadWeapon">
<div class="screen">
<div style="position:absolute;left:0dp;top:0dp;width:640dp;height:480dp;">
<div class="item decoration" style="left:0dp;top:0dp;width:640dp;height:480dp;decorator:image(&quot;gfx/menus/datapad&quot;);image-color:#ffffffff;" data-index="0" data-name="background" data-group="none"></div>
<div class="item" style="left:50dp;top:150dp;width:95dp;height:40dp;" data-index="1" data-name="weapons" data-group="none"></div>
<div class="item decoration" style="left:170dp;top:3dp;width:300dp;height:26dp;" data-index="2" data-name="screen_title"><span style="top:0dp;font-family:anewhope;font-size:20.4dp;left:-850dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_DATAPADTITLE</span></div>
<div class="item hidden decoration" style="left:0dp;top:0dp;width:640dp;height:480dp;" data-index="3" data-name="weapon1" data-group="none"></div>
<div class="item hidden decoration" style="left:320dp;top:220dp;width:110dp;height:20dp;" data-index="4" data-name="weapon1_line1" data-group="none"><span style="top:102dp;font-family:ergoec;font-size:20dp;left:32dp;color:#262626ff;">@MENUS_THIS_IS_LINE_1</span><span style="top:100dp;font-family:ergoec;font-size:20dp;left:30dp;color:#6eb3b8ff;">@MENUS_THIS_IS_LINE_1</span></div>
<div class="item hidden decoration" style="left:245dp;top:382dp;width:32dp;height:26dp;decorator:image(&quot;gfx/menus/dp_arrow_lon&quot;);image-color:#ffffffff;" data-index="5" data-name="prevweapon_on" data-group="none"></div>
<div class="item decoration" style="left:245dp;top:382dp;width:32dp;height:26dp;decorator:image(&quot;gfx/menus/dp_arrow_l&quot;);image-color:#ffffffff;" data-index="6" data-name="prevweapon_off" data-group="none"></div>
<div class="item" style="left:245dp;top:382dp;width:32dp;height:26dp;" data-index="7" data-name="prevweapon" data-group="none" data-desc="@MENUS_DP_WEAPON_PREV" data-action="play sound/interface/button1.wav;uiscript prevDataPadWeapon" data-mouseenter="hide prevweapon_off;show prevweapon_on" data-mouseexit="show prevweapon_off;hide prevweapon_on"></div>
<div class="item hidden decoration" style="left:364dp;top:382dp;width:32dp;height:26dp;decorator:image(&quot;gfx/menus/dp_arrow_ron&quot;);image-color:#ffffffff;" data-index="8" data-name="nextweapon_on" data-group="none"></div>
<div class="item decoration" style="left:364dp;top:382dp;width:32dp;height:26dp;decorator:image(&quot;gfx/menus/dp_arrow_r&quot;);image-color:#ffffffff;" data-index="9" data-name="nextweapon_off" data-group="none"></div>
<div class="item" style="left:364dp;top:382dp;width:32dp;height:26dp;" data-index="10" data-name="nextweapon" data-group="none" data-desc="@MENUS_DP_WEAPON_NEXT" data-action="play sound/interface/button1.wav;uiscript nextDataPadWeapon" data-mouseenter="hide nextweapon_off;show nextweapon_on" data-mouseexit="show nextweapon_off;hide nextweapon_on"></div>
<div class="item" style="left:20dp;top:420dp;width:120dp;height:25dp;" data-index="11" data-name="mission" data-group="none" data-desc="@MENUS_AN_OVERVIEW_OF_MISSION" data-action="play sound/interface/button1.wav;close all;open datapadMissionMenu" data-mouseenter="show button_glow;setitemrect button_glow 10 419 150 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:ergoec;font-size:20dp;left:-940dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_DP_MISSION</span></div>
<div class="item decoration" style="left:140dp;top:420dp;width:120dp;height:25dp;" data-index="12" data-name="weapons" data-group="none"><span style="top:0dp;font-family:ergoec;font-size:20dp;left:-940dp;width:2000dp;text-align:center;color:#ffffffff;">@MENUS_WEAPONS</span></div>
<div class="item" style="left:260dp;top:420dp;width:120dp;height:25dp;" data-index="13" data-name="force" data-group="none" data-desc="@MENUS_VIEW_CURRENT_FORCE_POWERS" data-action="play sound/interface/button1.wav;close all;open datapadForcePowersMenu" data-mouseenter="show button_glow;setitemrect button_glow 250 419 150 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:ergoec;font-size:20dp;left:-940dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_DP_FORCE</span></div>
<div class="item" style="left:380dp;top:420dp;width:120dp;height:25dp;" data-index="14" data-name="moves" data-group="none" data-desc="@MENUS_MOVES_DESC" data-action="play sound/interface/button1.wav;close all;open datapadMovesMenu" data-mouseenter="show button_glow;setitemrect button_glow 370 419 150 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:ergoec;font-size:20dp;left:-940dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_MOVES</span></div>
<div class="item" style="left:500dp;top:420dp;width:120dp;height:25dp;" data-index="15" data-name="exit" data-group="none" data-desc="@MENUS_RETURN_TO_GAME" data-action="play sound/interface/button1.wav;uiscript closedatapad" data-mouseenter="show button_glow;setitemrect button_glow 490 419 150 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:ergoec;font-size:20dp;left:-940dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_RESUME</span></div>
<div class="item hidden decoration" style="left:0dp;top:0dp;width:0dp;height:0dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="16" data-name="button_glow" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:640dp;height:640dp;decorator:image(&quot;gfx/menus/scanlines&quot;);image-color:#ffffffff;" data-index="17" data-name="scan" data-group="none"></div>
</div>
<div id="rmlpaint" style="decorator:image(&quot;rmlpaint/datapadWeaponsMenu&quot;);"></div>
<div id="rmldesc" style="left:-680dp;top:444dp;font-size:14dp;text-align:center;color:#ffae00cc;width:2000dp;"></div>
</div>
</body>
</rml>
