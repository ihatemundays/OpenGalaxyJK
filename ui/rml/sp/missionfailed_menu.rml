<rml>
<head>
<title>missionfailed_menu</title>
<link type="text/rcss" href="ui/rml/base.rcss"/>
<style>.item:hover span { color: #ffffffff; }</style>
</head>
<body style="" data-menu="missionfailed_menu" data-x="1.0" data-y="1.0" data-onopen="setcvar ui_missionfailed 0">
<div class="screen">
<div style="position:absolute;left:1dp;top:1dp;width:640dp;height:480dp;">
<div class="item decoration" style="left:50dp;top:10dp;width:540dp;height:80dp;background-color:#04043a80;" data-index="0" data-name="top_background"></div>
<div class="item decoration" style="left:170dp;top:380dp;width:300dp;height:95dp;background-color:#04043a80;" data-index="1" data-name="bottom_background"></div>
<div class="item decoration" style="left:0dp;top:20dp;width:640dp;height:16dp;" data-index="2" data-name="failed_title" data-group="title"><span style="top:-1dp;font-family:anewhope;font-size:17dp;left:-680dp;width:2000dp;text-align:center;color:#ff0000ff;">@SP_INGAME_MISSIONFAILED</span></div>
<div class="item decoration" style="left:0dp;top:60dp;width:640dp;height:0dp;" data-index="3" data-name="why_text" data-group="none"><span class="cvartext" data-cvar="ui_missionfailed_text" style="top:-1dp;font-family:anewhope;font-size:11.9dp;left:-680dp;width:2000dp;text-align:center;color:#ff0000ff;"></span></div>
<div class="item hidden decoration" style="left:118dp;top:295dp;width:85dp;height:26dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="4" data-name="button_glow" data-group="none"></div>
<div class="item" style="left:170dp;top:380dp;width:300dp;height:20dp;" data-index="5" data-name="restartauto" data-group="grpControlbutton" data-desc="@MENUS_LOAD_AUTOSAVE_DESC" data-action="play sound/misc/nomenu.wav;close all;uiscript load_auto" data-mouseenter="show button_glow;setitemrect button_glow 170 378 300 24" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:arialnb;font-size:14dp;left:-850dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_LOAD_AUTOSAVE</span></div>
<div class="item" style="left:170dp;top:400dp;width:300dp;height:20dp;" data-index="6" data-name="loadsave" data-group="grpControlbutton" data-desc="@MENUS_LOAD_SAVE_GAME_DESC" data-action="play sound/misc/nomenu.wav;close all;setcvar cl_paused 1;setcvar ui_missionfailed 1;open ingameloadMenu" data-mouseenter="show button_glow;setitemrect button_glow 170 398 300 24" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:arialnb;font-size:14dp;left:-850dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_LOAD_SAVE_GAME</span></div>
<div class="item" style="left:170dp;top:420dp;width:300dp;height:20dp;" data-index="7" data-name="instantload" data-group="grpControlbutton" data-desc="@MENUS_INSTANT_LOAD_CAPS_DESC" data-action="play sound/misc/nomenu.wav;close all;uiscript load_quick" data-mouseenter="show button_glow;setitemrect button_glow 170 418 300 24" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:arialnb;font-size:14dp;left:-850dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_INSTANT_LOAD_CAPS</span></div>
<div class="item cvarstate" style="left:170dp;top:440dp;width:300dp;height:20dp;" data-index="8" data-cvartest="tier_storyinfo" data-cvarrule="show" data-cvarvalues="1;2;3;4;5;6" data-name="missionselect" data-group="grpControlbutton" data-desc="@MENUS_NEW_MISSION_DESC" data-action="play sound/misc/nomenu.wav;setcvar cl_paused 1;uiscript decrementforcepowerlevel;close all;open ingameMissionSelect1" data-mouseenter="show button_glow;setitemrect button_glow 170 438 300 24" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:arialnb;font-size:14dp;left:-850dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_NEW_MISSION</span></div>
<div class="item cvarstate" style="left:170dp;top:440dp;width:300dp;height:20dp;" data-index="9" data-cvartest="tier_storyinfo" data-cvarrule="show" data-cvarvalues="7;8;9;10;11;12" data-name="missionselect" data-group="grpControlbutton" data-desc="@MENUS_NEW_MISSION_DESC" data-action="play sound/misc/nomenu.wav;setcvar cl_paused 1;uiscript decrementforcepowerlevel;close all;open ingameMissionSelect2" data-mouseenter="show button_glow;setitemrect button_glow 170 438 300 24" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:arialnb;font-size:14dp;left:-850dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_NEW_MISSION</span></div>
<div class="item cvarstate" style="left:170dp;top:440dp;width:300dp;height:20dp;" data-index="10" data-cvartest="tier_storyinfo" data-cvarrule="show" data-cvarvalues="13;14;15;16;17;18" data-name="missionselect" data-group="grpControlbutton" data-desc="@MENUS_NEW_MISSION_DESC" data-action="play sound/misc/nomenu.wav;setcvar cl_paused 1;uiscript decrementforcepowerlevel;close all;open ingameMissionSelect3" data-mouseenter="show button_glow;setitemrect button_glow 170 438 300 24" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:arialnb;font-size:14dp;left:-850dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_NEW_MISSION</span></div>
</div>
<div id="rmlpaint" style="decorator:image(&quot;rmlpaint/missionfailed_menu&quot;);"></div>
