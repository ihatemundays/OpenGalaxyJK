<rml>
<head>
<title>datapadForcePowersMenu</title>
<link type="text/rcss" href="ui/rml/base.rcss"/>
<style>.item:hover span { color: #ffffffff; }</style>
</head>
<body style="background-color:#000000ff;" data-menu="datapadForcePowersMenu" data-x="0.0" data-y="0.0" data-onopen="uiscript nextDataPadForcePower">
<div class="screen">
<div style="position:absolute;left:0dp;top:0dp;width:640dp;height:480dp;">
<div class="item decoration" style="left:0dp;top:0dp;width:640dp;height:480dp;decorator:image(&quot;gfx/menus/datapad&quot;);image-color:#ffffffff;" data-index="0" data-name="background" data-group="none"></div>
<div class="item" style="left:50dp;top:40dp;width:95dp;height:40dp;" data-index="1" data-name="forcepowers" data-group="none"></div>
<div class="item decoration" style="left:170dp;top:3dp;width:300dp;height:26dp;" data-index="2" data-name="screen_title"><span style="top:0dp;font-family:anewhope;font-size:20.4dp;left:-850dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_DATAPADTITLE</span></div>
<div class="item hidden decoration" style="left:245dp;top:382dp;width:32dp;height:26dp;decorator:image(&quot;gfx/menus/dp_arrow_lon&quot;);image-color:#ffffffff;" data-index="3" data-name="prevpower_on" data-group="none"></div>
<div class="item decoration" style="left:245dp;top:382dp;width:32dp;height:26dp;decorator:image(&quot;gfx/menus/dp_arrow_l&quot;);image-color:#ffffffff;" data-index="4" data-name="prevpower_off" data-group="none"></div>
<div class="item" style="left:245dp;top:382dp;width:32dp;height:26dp;" data-index="5" data-name="prevpower" data-group="none" data-desc="@MENUS_DP_FORCE_PREV" data-action="play sound/interface/button1.wav;uiscript prevDataPadForcePower" data-mouseenter="hide prevpower_off;show prevpower_on" data-mouseexit="show prevpower_off;hide prevpower_on"></div>
<div class="item hidden decoration" style="left:364dp;top:382dp;width:32dp;height:26dp;decorator:image(&quot;gfx/menus/dp_arrow_ron&quot;);image-color:#ffffffff;" data-index="6" data-name="nextpower_on" data-group="none"></div>
<div class="item decoration" style="left:364dp;top:382dp;width:32dp;height:26dp;decorator:image(&quot;gfx/menus/dp_arrow_r&quot;);image-color:#ffffffff;" data-index="7" data-name="nextpower_off" data-group="none"></div>
<div class="item" style="left:364dp;top:382dp;width:32dp;height:26dp;" data-index="8" data-name="nextpower" data-group="none" data-desc="@MENUS_DP_FORCE_NEXT" data-action="play sound/interface/button1.wav;uiscript nextDataPadForcePower" data-mouseenter="hide nextpower_off;show nextpower_on" data-mouseexit="show nextpower_off;hide nextpower_on"></div>
<div class="item" style="left:20dp;top:420dp;width:120dp;height:25dp;" data-index="9" data-name="mission" data-group="none" data-desc="@MENUS_AN_OVERVIEW_OF_MISSION" data-action="play sound/interface/button1.wav;close all;open datapadMissionMenu" data-mouseenter="show button_glow;setitemrect button_glow 10 419 150 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:ergoec;font-size:20dp;left:-940dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_DP_MISSION</span></div>
<div class="item" style="left:140dp;top:420dp;width:120dp;height:25dp;" data-index="10" data-name="weapons" data-group="none" data-desc="@MENUS_VIEW_CURRENTLY_OWNED" data-action="play sound/interface/button1.wav;close all;open datapadWeaponsMenu" data-mouseenter="show button_glow;setitemrect button_glow 130 419 150 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:ergoec;font-size:20dp;left:-940dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_WEAPONS</span></div>
<div class="item decoration" style="left:260dp;top:420dp;width:120dp;height:25dp;" data-index="11" data-name="force" data-group="none"><span style="top:0dp;font-family:ergoec;font-size:20dp;left:-940dp;width:2000dp;text-align:center;color:#ffffffff;">@MENUS_DP_FORCE</span></div>
<div class="item" style="left:380dp;top:420dp;width:120dp;height:25dp;" data-index="12" data-name="moves" data-group="none" data-desc="@MENUS_MOVES_DESC" data-action="play sound/interface/button1.wav;close all;open datapadMovesMenu" data-mouseenter="show button_glow;setitemrect button_glow 370 419 150 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:ergoec;font-size:20dp;left:-940dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_MOVES</span></div>
<div class="item" style="left:500dp;top:420dp;width:120dp;height:25dp;" data-index="13" data-name="exit" data-group="none" data-desc="@MENUS_RETURN_TO_GAME" data-action="play sound/interface/button1.wav;uiscript closedatapad" data-mouseenter="show button_glow;setitemrect button_glow 490 419 150 30" data-mouseexit="hide button_glow"><span style="top:0dp;font-family:ergoec;font-size:20dp;left:-940dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_RESUME</span></div>
<div class="item hidden decoration" style="left:0dp;top:0dp;width:0dp;height:0dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="14" data-name="button_glow" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:640dp;height:640dp;decorator:image(&quot;gfx/menus/scanlines&quot;);image-color:#ffffffff;" data-index="15" data-name="scan" data-group="none"></div>
</div>
<div id="rmlpaint" style="decorator:image(&quot;rmlpaint/datapadForcePowersMenu&quot;);"></div>
<div id="rmldesc" style="left:-680dp;top:444dp;font-size:14dp;text-align:center;color:#ffae00cc;width:2000dp;"></div>
</div>
</body>
</rml>
