<rml>
<head>
<title>ingameMainMenu</title>
<link type="text/rcss" href="ui/rml/base.rcss"/>
<style>.item:hover span { color: #ffffffff; }</style>
</head>
<body style="background-color:#000000ff;" data-menu="ingameMainMenu" data-x="0.0" data-y="0.0" data-onopen="setfocus resume">
<div class="screen">
<div style="position:absolute;left:0dp;top:0dp;width:640dp;height:480dp;">
<div class="item decoration" style="left:156dp;top:154dp;width:320dp;height:240dp;decorator:image(&quot;gfx/menus/main_centerblue&quot;);image-color:#ffffffff;" data-index="0" data-name="really_background" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text&quot;);image-color:#ffffffff;" data-index="1" data-name="background_text" data-group="none"></div>
<div class="item decoration" style="left:480dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text_right&quot;);image-color:#ffffffff;" data-index="2" data-name="background_text_b" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:640dp;height:480dp;decorator:image(&quot;gfx/menus/main_background&quot;);image-color:#ffffffff;" data-index="3" data-name="background" data-group="none"></div>
<div class="item decoration" style="left:107dp;top:8dp;width:428dp;height:112dp;decorator:image(&quot;gfx/menus/jediacademy&quot;);image-color:#ffffffff;" data-index="4" data-name="starwars" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:50dp;width:320dp;height:160dp;decorator:image(&quot;gfx/menus/menu_boxes_left&quot;);image-color:#ffffffff;" data-index="5" data-name="left_frame" data-group="lf_fr"></div>
<div class="item decoration" style="left:320dp;top:50dp;width:320dp;height:160dp;decorator:image(&quot;gfx/menus/menu_boxes_right&quot;);image-color:#ffffffff;" data-index="6" data-name="right_frame" data-group="rt_fr"></div>
<div class="item hidden decoration" style="left:7dp;top:126dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="7" data-name="savegamebutton_glow" data-group="mods"></div>
<div class="item" style="left:7dp;top:126dp;width:130dp;height:24dp;" data-index="8" data-name="savegamebutton" data-group="nbut" data-desc="@MENUS_SAVE_CURRENT_GAME" data-action="play sound/interface/button1.wav;close all;open ingamesaveMenu" data-mouseenter="show savegamebutton_glow" data-mouseexit="hide savegamebutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_SAVE</span></div>
<div class="item hidden decoration" style="left:170dp;top:126dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="9" data-name="loadgamebutton_glow" data-group="none"></div>
<div class="item" style="left:170dp;top:126dp;width:130dp;height:24dp;" data-index="10" data-name="loadgamebutton" data-group="lbut" data-desc="@MENUS_LOAD_A_SAVED_GAME" data-action="play sound/interface/button1.wav;close all;open ingameloadMenu" data-mouseenter="show loadgamebutton_glow" data-mouseexit="hide loadgamebutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_LOAD</span></div>
<div class="item hidden decoration" style="left:340dp;top:126dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="11" data-name="controlsbutton_glow" data-group="none"></div>
<div class="item" style="left:340dp;top:126dp;width:130dp;height:24dp;" data-index="12" data-name="controlsbutton" data-group="cbut" data-desc="@MENUS_CONFIGURE_GAME_CONTROLS" data-action="play sound/interface/button1.wav;close all;open ingamecontrolsMenu" data-mouseenter="show controlsbutton_glow" data-mouseexit="hide controlsbutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_CONTROLS</span></div>
<div class="item hidden decoration" style="left:502dp;top:126dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="13" data-name="setupbutton_glow" data-group="none"></div>
<div class="item" style="left:502dp;top:126dp;width:130dp;height:24dp;" data-index="14" data-name="setupbutton" data-group="sbut" data-desc="@MENUS_CONFIGURE_GAME_SETTINGS" data-action="play sound/interface/button1.wav;close all;open ingamesetupMenu" data-mouseenter="show setupbutton_glow" data-mouseexit="hide setupbutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_SETUP</span></div>
<div class="item hidden decoration" style="left:255dp;top:444dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="15" data-name="exitgamebutton_glow" data-group="mods"></div>
<div class="item" style="left:255dp;top:444dp;width:130dp;height:24dp;" data-index="16" data-name="exitgamebutton" data-group="exit" data-desc="@MENUS_JEDI_KNIGHT_II" data-action="play sound/weapons/saber/saberoff.mp3;close all;open ingamequitMenu" data-mouseenter="show exitgamebutton_glow" data-mouseexit="hide exitgamebutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#262626ff;">@MENUS_EXIT</span><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_EXIT</span></div>
<div class="item hidden decoration" style="left:455dp;top:444dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="17" data-name="resumebutton_glow" data-group="mods"></div>
<div class="item" style="left:455dp;top:444dp;width:130dp;height:24dp;" data-index="18" data-name="resume" data-group="none" data-desc="@MENUS_RESUME_CURRENT_GAME" data-action="play sound/interface/button1.wav;uiscript closeingame" data-mouseenter="show resumebutton_glow" data-mouseexit="hide resumebutton_glow"><span style="top:0dp;font-family:anewhope;font-size:17dp;left:-935dp;width:2000dp;text-align:center;color:#262626ff;">@MENUS_RESUME</span><span style="top:-1dp;font-family:anewhope;font-size:17dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_RESUME</span></div>
</div>
<div id="rmlpaint" style="decorator:image(&quot;rmlpaint/ingameMainMenu&quot;);"></div>
<div id="rmldesc" style="left:-680dp;top:426dp;font-size:14dp;text-align:center;color:#ffae00cc;width:2000dp;"></div>
</div>
</body>
</rml>
