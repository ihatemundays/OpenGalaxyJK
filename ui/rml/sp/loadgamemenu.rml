<rml>
<head>
<title>loadgameMenu</title>
<link type="text/rcss" href="ui/rml/base.rcss"/>
<style>.item:hover span { color: #ffffffff; }</style>
</head>
<body style="background-color:#000000ff;" data-menu="loadgameMenu" data-x="0.0" data-y="0.0" data-onopen="uiscript ReadSaveDirectory">
<div class="screen">
<div style="position:absolute;left:0dp;top:0dp;width:640dp;height:480dp;">
<div class="item decoration" style="left:156dp;top:154dp;width:320dp;height:240dp;decorator:image(&quot;gfx/menus/main_centerblue&quot;);image-color:#ffffffff;" data-index="0" data-name="really_background" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text&quot;);image-color:#ffffffff;" data-index="1" data-name="background_text" data-group="none"></div>
<div class="item decoration" style="left:480dp;top:0dp;width:160dp;height:480dp;decorator:image(&quot;gfx/menus/menu_side_text_right&quot;);image-color:#ffffffff;" data-index="2" data-name="background_text_b" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:0dp;width:640dp;height:480dp;decorator:image(&quot;gfx/menus/main_background&quot;);image-color:#ffffffff;" data-index="3" data-name="background" data-group="none"></div>
<div class="item decoration" style="left:107dp;top:8dp;width:428dp;height:112dp;decorator:image(&quot;gfx/menus/jediacademy&quot;);image-color:#ffffffff;" data-index="4" data-name="starwars" data-group="none"></div>
<div class="item decoration" style="left:0dp;top:50dp;width:320dp;height:160dp;decorator:image(&quot;gfx/menus/menu_boxes_left&quot;);image-color:#ffffffff;" data-index="5" data-name="left_frame" data-group="lf_fr"></div>
<div class="item decoration" style="left:320dp;top:50dp;width:320dp;height:160dp;decorator:image(&quot;gfx/menus/menu_boxes_right&quot;);image-color:#ffffffff;" data-index="6" data-name="right_frame" data-group="rt_fr"></div>
<div class="item hidden decoration" style="left:7dp;top:126dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="7" data-name="newbutton_glow" data-group="none"></div>
<div class="item" style="left:7dp;top:126dp;width:130dp;height:24dp;" data-index="8" data-name="newgamebutton" data-group="nbut" data-desc="@MENUS_START_A_NEW_GAME" data-action="play sound/interface/button1.wav;close all;open newgameMenu" data-mouseenter="show newbutton_glow" data-mouseexit="hide newbutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_NEW</span></div>
<div class="item hidden decoration" style="left:170dp;top:126dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="9" data-name="loadgamebutton_glow" data-group="none"></div>
<div class="item" style="left:170dp;top:126dp;width:130dp;height:24dp;" data-index="10" data-name="loadgamebutton" data-group="lbut" data-desc="@MENUS_LOAD_A_SAVED_GAME" data-mouseenter="show loadgamebutton_glow" data-mouseexit="hide loadgamebutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffffffff;">@MENUS_LOAD</span></div>
<div class="item hidden decoration" style="left:340dp;top:126dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="11" data-name="controlsbutton_glow" data-group="none"></div>
<div class="item" style="left:340dp;top:126dp;width:130dp;height:24dp;" data-index="12" data-name="controlsbutton" data-group="cbut" data-desc="@MENUS_CONFIGURE_GAME_CONTROLS" data-action="play sound/interface/button1.wav;close all;open controlsMenu" data-mouseenter="show controlsbutton_glow" data-mouseexit="hide controlsbutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_CONTROLS</span></div>
<div class="item hidden decoration" style="left:502dp;top:126dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="13" data-name="setupbutton_glow" data-group="none"></div>
<div class="item" style="left:502dp;top:126dp;width:130dp;height:24dp;" data-index="14" data-name="setupbutton" data-group="sbut" data-desc="@MENUS_CONFIGURE_GAME_SETTINGS" data-action="play sound/interface/button1.wav;close all;open setupMenu" data-mouseenter="show setupbutton_glow" data-mouseexit="hide setupbutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_SETUP</span></div>
<div class="item hidden decoration" style="left:59dp;top:444dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="15" data-name="backbutton_glow" data-group="mods"></div>
<div class="item" style="left:59dp;top:444dp;width:130dp;height:24dp;" data-index="16" data-name="backbutton" data-group="exit" data-desc="@MENUS_BACKTOMAIN" data-action="play sound/interface/esc.wav;close all;open mainMenu" data-mouseenter="show backbutton_glow" data-mouseexit="hide backbutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#262626ff;">@MENUS_BACK</span><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_BACK</span></div>
<div class="item hidden decoration" style="left:255dp;top:444dp;width:130dp;height:24dp;decorator:image(&quot;gfx/menus/menu_buttonback&quot;);image-color:#ffffffff;" data-index="17" data-name="exitgamebutton_glow" data-group="mods"></div>
<div class="item" style="left:255dp;top:444dp;width:130dp;height:24dp;" data-index="18" data-name="exitgamebutton" data-group="exit" data-desc="@MENUS_JEDI_KNIGHT_II" data-action="play sound/weapons/saber/saberoff.mp3;close all;open quitMenu" data-mouseenter="show exitgamebutton_glow" data-mouseexit="hide exitgamebutton_glow"><span style="top:0dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#262626ff;">@MENUS_EXIT</span><span style="top:-1dp;font-family:anewhope;font-size:18.7dp;left:-935dp;width:2000dp;text-align:center;color:#ffae00ff;">@MENUS_EXIT</span></div>
<div class="item decoration" style="left:100dp;top:164dp;width:440dp;height:16dp;decorator:image(&quot;gfx/menus/menu_blendbox&quot;);image-color:#8cdaffff;" data-index="19" data-name="loadgame_title" data-group="title"><span style="top:-1dp;font-family:anewhope;font-size:11.9dp;left:-775dp;width:2000dp;text-align:center;color:#8cdaffff;">@MENUS_LOAD_GAME</span></div>
<div class="item" style="left:41dp;top:201dp;width:360dp;height:190dp;" data-index="20" data-name="loadgamelist" data-group="loadscreen" data-action="play sound/interface/sub_select" data-mouseenter="setitemcolor loadgamelist bordercolor 1 1 1 1" data-mouseexit="setitemcolor loadgamelist bordercolor 0 0 .8 1"></div>
<div class="item decoration" style="left:436dp;top:201dp;width:180dp;height:135dp;" data-index="21" data-name="loadgamepic" data-group="loadscreen"></div>
<div class="item hidden decoration" style="left:440dp;top:360dp;width:190dp;height:20dp;decorator:image(&quot;gfx/menus/menu_blendbox2&quot;);image-color:#ffffffff;" data-index="22" data-name="loadgameaction_glow" data-group="glow"></div>
<div class="item cvarstate" style="left:440dp;top:360dp;width:190dp;height:20dp;" data-index="23" data-cvartest="ui_SelectionOK" data-cvarrule="enable" data-cvarvalues="1" data-name="loadgameaction" data-group="actionbutton" data-desc="@MENUS_LOAD_CHOSEN_GAME" data-action="play sound/interface/button1.wav;hide glow;uiscript loadgame" data-mouseenter="show loadgameaction_glow" data-mouseexit="hide loadgameaction_glow"><span style="top:1dp;font-family:anewhope;font-size:13.6dp;left:-1825dp;width:2000dp;text-align:right;color:#ffae00ff;">@MENUS_LOAD_GAME</span></div>
<div class="item hidden decoration" style="left:440dp;top:385dp;width:190dp;height:20dp;decorator:image(&quot;gfx/menus/menu_blendbox2&quot;);image-color:#ffffffff;" data-index="24" data-name="deletegameaction_glow" data-group="glow"></div>
<div class="item cvarstate" style="left:440dp;top:385dp;width:175dp;height:25dp;" data-index="25" data-cvartest="ui_SelectionOK" data-cvarrule="enable" data-cvarvalues="1" data-name="deletegamebutton" data-group="actionbutton" data-desc="@MENUS_DELETE_CHOSEN_GAME" data-action="play sound/interface/button1.wav;hide glow;uiscript deletegame" data-mouseenter="show deletegameaction_glow" data-mouseexit="hide deletegameaction_glow"><span style="top:1dp;font-family:anewhope;font-size:13.6dp;left:-1825dp;width:2000dp;text-align:right;color:#ffae00ff;">@MENUS_DELETE_GAME</span></div>
<div class="item hidden decoration" style="left:440dp;top:410dp;width:190dp;height:20dp;decorator:image(&quot;gfx/menus/menu_blendbox2&quot;);image-color:#ffffffff;" data-index="26" data-name="resumegameaction_glow" data-group="glow"></div>
<div class="item cvarstate" style="left:440dp;top:410dp;width:175dp;height:25dp;" data-index="27" data-cvartest="ui_ResumeOK" data-cvarrule="enable" data-cvarvalues="1" data-name="resumeautobutton" data-group="actionbutton" data-desc="@MENUS_RESUME_LAST_MISSION_ENTERED" data-action="play sound/interface/button1.wav;hide glow;uiscript loadAuto" data-mouseenter="show resumegameaction_glow" data-mouseexit="hide resumegameaction_glow"><span style="top:1dp;font-family:anewhope;font-size:13.6dp;left:-1825dp;width:2000dp;text-align:right;color:#ffae00ff;">@MENUS_RESUME_MISSION</span></div>
</div>
<div id="rmlpaint" style="decorator:image(&quot;rmlpaint/loadgameMenu&quot;);"></div>
<div id="rmldesc" style="left:-680dp;top:426dp;font-size:14dp;text-align:center;color:#ffae00cc;width:2000dp;"></div>
</div>
</body>
</rml>
